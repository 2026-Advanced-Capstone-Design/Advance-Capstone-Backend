{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.1.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["newslens", "ai-engine", "semaphore"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NewsLens — AI Engine 세마포어 백프레셔",
  "uid": "ai-engine-semaphore",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "동시 실행 분석 수 (ai_active_analyses) — 상한 N에서 클리핑되어야 정상",
      "description": "세마포어를 점유해 실제로 실행 중인 파이프라인 수. before(무제한)=급증, after(N제한)=N에서 평탄.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ai_active_analyses",
          "legendFormat": "active {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "백프레셔 대기 큐 (ai_analyses_waiting) — 세마포어 자리 기다리는 수",
      "description": "상한에 걸려 PENDING으로 줄 선 분석 수. after에서 여기 쌓이는 게 백프레셔 작동 증거.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ai_analyses_waiting",
          "legendFormat": "waiting {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "관측 구간 최대 동시 실행 (peak active)",
      "description": "선택한 시간범위 동안 ai_active_analyses의 최댓값. before/after 비교용.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 20 }
          ] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(max_over_time(ai_active_analyses[$__range]))",
          "legendFormat": "peak active"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "관측 구간 최대 대기 (peak waiting)",
      "description": "선택한 시간범위 동안 ai_analyses_waiting의 최댓값.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(max_over_time(ai_analyses_waiting[$__range]))",
          "legendFormat": "peak waiting"
        }
      ]
    }
  ]
}
