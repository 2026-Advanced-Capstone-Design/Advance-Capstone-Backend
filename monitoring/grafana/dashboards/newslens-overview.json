{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "uid": "newslens-overview",
  "title": "NewsLens — Backend Overview (Phase 1)",
  "tags": ["newslens", "phase1"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 응답시간 p95 / p99 (초)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"backend\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM 힙 사용량 (MB)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"backend\", area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"backend\", area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "스레드풀 큐 깊이 (executor.queued)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "executor_queued_tasks{job=\"backend\"}",
          "legendFormat": "{{name}} queued"
        },
        {
          "refId": "B",
          "expr": "executor_active_threads{job=\"backend\"}",
          "legendFormat": "{{name}} active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI 엔진 호출 지연 p95 (초)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_analyze_request_seconds_bucket{job=\"backend\"}[5m])) by (le))",
          "legendFormat": "AI call p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "캐시 히트율 (relatedArticles)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_gets_total{job=\"backend\", result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{job=\"backend\"}[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "에러 로그율 (ERROR/분) — Loki",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"backend\", level=\"ERROR\"}[1m]))",
          "legendFormat": "ERROR/min"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HikariCP 커넥션 풀 (Phase 8 실측)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"backend\"}",
          "legendFormat": "active (사용 중)"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending{job=\"backend\"}",
          "legendFormat": "pending (대기 스레드)"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max{job=\"backend\"}",
          "legendFormat": "max (풀 상한)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "콜백 재시도 (ai_callback_retry, 5분 증가량)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(ai_callback_retry_total{job=\"ai-engine\"}[5m])",
          "legendFormat": "retries / 5m"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "콜백 최종 실패 누적 (0이어야 정상)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_callback_final_failure_total{job=\"ai-engine\"}) or vector(0)",
          "legendFormat": "final failures"
        }
      ]
    }
  ]
}
